{
  "schemaVersion": 1,
  "id": "book-writer",
  "version": "${version}",
  "name": "InSearchOfName's Book Writer",
  "description": "A client-side mod that allows you to quickly write text into multiple Minecraft books using the .write command.",
  "authors": [
    "Tommy (InSearchOfName)"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "Apache-2.0",
  "icon": "assets/book-writer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "name.insearchof.BookWriterClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "owo": "0.13.1"
  }
}